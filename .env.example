SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=sqlite:///data/seo_tools.db
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
API_HOST=0.0.0.0
API_PORT=8000

# Rate limiting (SlowAPI). RATE_LIMIT_ENABLED=false disables the limiter entirely,
# which is what the test suite needs.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
RATE_LIMIT_ENABLED=true
ANALYZE_RATE_LIMIT=40/minute
BATCH_RATE_LIMIT=10/minute
SCRAPE_RATE_LIMIT=20/minute

# Request cap, applied before the body is read.
MAX_REQUEST_BYTES=6291456

# Origins allowed to call the API from a browser. Extension origins are matched by
# CORS_ORIGIN_REGEX (a wildcard string cannot be compared for equality).
CORS_ORIGIN_REGEX=chrome-extension://[a-p]{32}|http://localhost:\d+
